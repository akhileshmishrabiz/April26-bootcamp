  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "bars", "fillOpacity": 80 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "expr": "sum by (app) (count_over_time({namespace=\"ecommerce\"} |~ \"(?i)$log_level\" [1m]))",
        "legendFormat": "{{app}}",
        "refId": "A"
      }],
      "title": "Log Volume by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{
        "expr": "sum by (app) (count_over_time({namespace=\"ecommerce\"} |~ \"(?i)(error|fatal|panic|exception)\" [1m]))",
        "legendFormat": "{{app}} errors",
        "refId": "A"
      }],
      "title": "Error Log Rate by Service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 20 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [{
        "expr": "sum(count_over_time({namespace=\"ecommerce\", app=\"user-service\"} |~ \"(?i)(login|auth)\" [1m]))",
        "legendFormat": "auth events",
        "refId": "A"
      }],
      "title": "Auth Activity (user-service)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 12 },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showCommonLabels": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [{
        "expr": "{namespace=\"ecommerce\", app=~\"$service\"} |~ \"$search\" | json | line_format \"{{.level}} {{.msg}} {{.message}} {{.error}}\"",
        "refId": "A"
      }],
      "title": "Live Application Logs",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["logs", "loki"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({namespace=\"ecommerce\"}, app)",
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "query": "label_values({namespace=\"ecommerce\"}, app)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "error|warn|info", "value": "error|warn|info" },
        "label": "Log Level Filter",
        "name": "log_level",
        "options": [{ "selected": true, "text": "error|warn|info", "value": "error|warn|info" }],
        "query": "error|warn|info",
        "type": "textbox"
      },
      {
        "current": { "selected": false, "text": ".*", "value": ".*" },
        "label": "Search",
        "name": "search",
        "options": [{ "selected": true, "text": ".*", "value": ".*" }],
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Microservices Logs Explorer",
  "uid": "logs-explorer",
  "version": 2
